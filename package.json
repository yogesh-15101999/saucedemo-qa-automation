{
  "name": "saucedemo-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright (TypeScript) UI and API automation suite for saucedemo.com and reqres.in",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "automation",
    "page-object-model"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0"
  }
}
